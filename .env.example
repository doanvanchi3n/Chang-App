# ==============================================================================
# TEMPLATE CẤU HÌNH BIẾN MÔI TRƯỜNG CHẶNG APP (FLUTTER + SUPABASE + MCP)
# Hướng dẫn: Copy file này thành .env và điền các giá trị thực tế của bạn.
# LƯU Ý: File .env đã được cấu hình trong .gitignore, tuyệt đối KHÔNG commit file .env lên Git!
# ==============================================================================

# 1. CẤU HÌNH DÀNH CHO ỨNG DỤNG FLUTTER (CLIENT - AN TOÀN KHI PUBLIC)
# URL dự án Supabase của bạn (Lấy tại Dashboard -> Project Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable key dành cho client; quyền dữ liệu được kiểm soát bằng Auth và RLS.
# Flutter đọc hai biến public qua --dart-define, không tự nạp file .env này.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key


# ==============================================================================
# 2. CẤU HÌNH BẢO MẬT DÀNH CHO MCP SERVER & BACKEND (CỰC KỲ QUAN TRỌNG - BẢO MẬT CAO)
# CẢNH BÁO: KHÔNG BAO GIỜ NHÚNG CÁC KHÓA DƯỚI ĐÂY VÀO ỨNG DỤNG FLUTTER MOBILE!
# ==============================================================================

# Mã định danh dự án (Project Reference - ví dụ: 'abcdefghijklmnop')
# Lấy từ URL: https://supabase.com/dashboard/project/<project-ref>
SUPABASE_PROJECT_REF=your-project-ref

# Mật khẩu Cơ sở dữ liệu PostgreSQL đã đặt khi tạo dự án (Project Settings -> Database)
SUPABASE_DB_PASSWORD=your-database-password

# Khu vực máy chủ lưu trữ dự án (Project Settings -> General)
# Khu vực gần Việt Nam nhất thường là: ap-southeast-1 (Singapore)
SUPABASE_REGION=ap-southeast-1

# Khóa Quản trị Auth Admin SDK (Project Settings -> API -> service_role key)
# NGUY HIỂM: Khóa này có quyền bypass toàn bộ RLS, đọc/ghi toàn quyền database
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Token quản trị cá nhân (Tạo tại https://supabase.com/dashboard/account/tokens)
# Bắt đầu bằng 'sbp_...' - Dùng để kết nối MCP Server trực tiếp với Supabase
SUPABASE_ACCESS_TOKEN=sbp_your-personal-access-token

# (KHÔNG CẦN THIẾT): thequery.dev đã đóng cửa và không còn được sử dụng để đảm bảo bảo mật trực tiếp
# QUERY_API_KEY=not_needed
